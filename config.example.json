{
  "botUin": "请填机器人 QQ 号",
  "storagePath": "C:/Users/<you>/Documents/Tencent Files",
  "receive": "notify",
  "receiveIntervalMs": 1500,
  "botName": "请填机器人 QQ 昵称（必须与 QQ 完全一致）",
  "personaFile": "persona.md",
  "reply": {
    "private": true,
    "groups": [],
    "minIntervalMs": 1200,
    "maxPerMinute": 8,
    "readDelayMs": [500, 1600],
    "typingSpeedCps": 14,
    "maxTypingMs": 3500,
    "splitSegments": 2,
    "quietHours": { "enabled": false, "start": "23:30", "end": "08:00" },
    "verifySend": true,
    "staleAfterMs": 600000,
    "sendIdleMs": 45000,
    "sendMaxWaitMs": 600000
  },
  "models": {
    "default": "deepseek/deepseek-flash",
    "private": "deepseek/deepseek-flash",
    "group": "deepseek/deepseek-flash",
    "temperature": 0.8,
    "maxTokens": 512,
    "timeoutMs": 60000,
    "retries": 2,
    "fallback": true,
    "fallbackChain": [],
    "historyTokens": 3000
