  "providers": [
    {
      "id": "deepseek",
      "name": "DeepSeek",
      "kind": "openai",
      "baseURL": "https://api.deepseek.com/v1",
      "apiKey": "sk-替换成你自己的-key",
      "models": ["deepseek-flash"],
      "enabled": true,
      "priority": 1,
      "rpm": 0,
      "apiVersion": "",
      "note": ""
    }
  ],
  "plugins": { "disabled": [] },
  "search": {
    "enabled": true,
    "provider": "auto",
    "apiKey": "",
    "maxResults": 5,
    "maxRounds": 2,
    "maxCalls": 3
  },
  "webui": { "port": 8787, "host": "127.0.0.1", "token": "" }
